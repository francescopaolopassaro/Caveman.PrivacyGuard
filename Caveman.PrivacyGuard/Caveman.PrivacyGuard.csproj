<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Caveman.PrivacyGuard</PackageId>
    <Version>1.4.0</Version>
    <Authors>Francesco Paolo Passaro</Authors>
    <Description>Enterprise-grade PII &amp; Privacy Analyzer for AI/LLM workflows. Detects, scores, and auto-masks sensitive data across 32 countries (27 EU + UK, Switzerland, China, Russia, Ukraine) with GDPR/AI Act/NIS2/PCI-DSS/NIST compliance flags, multi-session and multi-chatbot support, AI transparency notices, multi-language support, and YAML-driven extensible rules.</Description>
    <PackageReleaseNotes>1.4.0: optional ML confirmation tier - IMlEntityDetector / PrivacyAnalyzer.MlDetector / MlSpan (the learned PrivacyGuardML model ships in the CavemanML package); a failed checksum still vetoes. 1.3.1: False-positive hardening ported from Synthelion 1.2.5 - a failed checksum is never detected or masked, bare numeric formats are gated by requires_context + nearby keyword, short keywords match as whole words, Maltese ID tightened, spaced phone/card numbers. 1.3.0: Streaming &amp; document masking (ported from Synthelion 1.2.5 privacy_stream.py / document_extractor.py). PrivacyStreamMasker: boundary-safe chunked/streaming PII masking with a configurable overlap window (default 512 chars) so patterns spanning a chunk boundary are caught; Feed()/Flush() API for incremental streams and a MaskStream() convenience helper for chunked iterables. PrivacySession.Summary(): redacted placeholder+category view (never the original value) safe to log/display/return over APIs, unlike GetAll()/ToJson() which carry cleartext PII (their XML docs now warn about this). DocumentMasker: streaming masking of plain text, Markdown and CSV files into a &quot;name.masked.ext&quot; copy next to the source (the original is never overwritten) — files are processed in chunks, never loaded whole; CSV rows are read with a minimal RFC-4180-aware reader so quoted multi-line cells survive. Added 12 new regression tests. 1.2.2: NuGet icon restored (caveman-icon.png now packed and referenced via PackageIcon).</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>caveman-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageProjectUrl>https://github.com/francescopaolopassaro/Caveman.PrivacyGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/francescopaolopassaro/Caveman.PrivacyGuard</RepositoryUrl>
    <PackageTags>privacy,gdpr,pii,ai,llm,security,masking,eu,compliance</PackageTags>
    <Title>Caveman.PrivacyGuard</Title>
    <Copyright>Copyright (c) 2026 Passaro Francesco Paolo</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.1.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
    <PackageReference Include="System.IO.FileSystem.Watcher" Version="4.3.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Caveman.PrivacyGuard.Tests\**" />
    <EmbeddedResource Remove="Caveman.PrivacyGuard.Tests\**" />
    <None Remove="Caveman.PrivacyGuard.Tests\**" />
  </ItemGroup>
<ItemGroup>
  <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
    <_Parameter1>Caveman.PrivacyGuard.Tests</_Parameter1>
  </AssemblyAttribute>
</ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="rules.yaml" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="caveman-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
